<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/TituloSeccion"
            android:text="OPERACIÓN EN DOS MOMENTOS" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="1) VÍA: se lee el QR o la placa y solo se valida (da acceso, sin detener el vehículo).\n2) INTERIOR: ya adentro se lee de nuevo, se registra el ingreso y se imprime el ticket."
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ajPerfilVia"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Equipo de la VÍA"
                android:textColor="@color/blanco"
                app:strokeColor="@color/tarjeta_borde" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ajPerfilInterior"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Equipo INTERIOR"
                android:textColor="@color/blanco"
                app:strokeColor="@color/tarjeta_borde" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajSoloValidarQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Al leer el QR: solo VALIDAR (si no, registra el ingreso)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajSoloValidarPlaca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Al leer la placa: solo VALIDAR (si no, registra el ingreso)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajImprimirValidar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Al validar: imprimir un comprobante corto" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajEnviarValidar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Al validar: enviar el registro al servidor" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajExigirValidacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bloquear adentro a quien no pasó por la vía (no recomendado: normalmente adentro se valida y registra)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajEnviarAlertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar las alertas (sin reserva, repetidos, colados) al servidor" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Minutos de espera antes de marcar en rojo"
            app:helperText="Un vehículo validado en la vía que no recibe ticket adentro pasado este tiempo se marca en rojo.">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajMinutosEspera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/TituloSeccion"
            android:layout_marginTop="18dp"
            android:text="OPERADOR Y TICKET" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del operador">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajOperador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Encabezado del ticket (parqueadero / empresa)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajNegocio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Mensaje de bienvenida"
            app:helperText="Use {nombre} y {evento} para poner los datos del cliente.">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Mensaje extra para clientes VIP">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajVip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Imprimir el ticket automáticamente al registrar" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incluir el QR de la reserva en el ticket" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajLector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leer el QR con el lector integrado del Sunmi (si no, con la cámara)" />

        <TextView
            style="@style/TituloSeccion"
            android:layout_marginTop="18dp"
            android:text="AVISOS AL LEER" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajSonidoLeer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sonar un pitido cuando se lee una reserva (por QR o por placa)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Si la reserva no se encuentra, ya estaba validada o hay algo raro, el equipo vibra en vez de sonar. El pitido usa el volumen de multimedia del equipo; si está en cero, vibra."
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <TextView
            style="@style/TituloSeccion"
            android:layout_marginTop="18dp"
            android:text="RED ENTRE EQUIPOS" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Los equipos que estén en el mismo Wi-Fi (el de un router, con o sin internet, o la zona Wi-Fi de uno de ellos) se avisan entre sí, en segundo plano, lo que validan o registran. No usa internet ni emparejar nada."
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajRedActiva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Compartir con los equipos cercanos" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nombre de este equipo"
            app:helperText="Así lo verán los demás. Ej: VÍA 1, INTERIOR 2.">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajNombreEquipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="24" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Papel de este equipo (administrador o receptor)"
            android:textColor="@color/blanco"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/ajSatelite"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todos los equipos reciben, registran y se reenvían todo entre sí. Solo los ADMINISTRADORES (máximo 2 a la vez, mínimo 1) hablan con el servidor: suben los registros, traen las reservas y las reparten a todos. Deje la mayoría en «Automático» y marque «Administrador» en 1 o 2 equipos que tengan buen internet (con la dirección del servidor puesta); si uno falla, el otro sigue. Los «Receptores» entregan lo suyo a un administrador. Todos los equipos deben estar conectados al mismo Wi-Fi."
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Clave de la red de equipos"
            app:endIconMode="password_toggle"
            app:helperText="Debe ser IGUAL en todos los equipos. Si la deja vacía se usa la clave predeterminada.">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajRedClave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLength="40" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="IP de otros equipos (solo si no se encuentran solos)"
            app:helperText="Opcional. Separadas por coma. Ej: 192.168.1.21, 192.168.1.22">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajRedIps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLength="200" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/ajEquiposTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/tarjeta"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="▸  Equipos conectados"
            android:textColor="@color/blanco"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ajEquiposCuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/ajEquiposAvisos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/rojo"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ajEquiposLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/ajEquiposVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ajSincronizar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sincronizar ahora"
                android:textColor="@color/blanco"
                app:strokeColor="@color/tarjeta_borde" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ajRedBateria"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Permitir trabajar en segundo plano (batería)"
            android:textColor="@color/blanco"
            app:strokeColor="@color/tarjeta_borde" />

        <TextView
            style="@style/TituloSeccion"
            android:layout_marginTop="18dp"
            android:text="SERVIDOR" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dirección para ENVIAR los registros (POST)"
            app:helperText="Ej: https://su-servidor.com/api/registros">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajUrlEnvio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Dirección para TRAER reservas nuevas (GET)"
            app:helperText="Ej: https://su-servidor.com/api/reservas">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajUrlReservas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Clave del servidor (token)"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Enviar cuando se junten (registros)"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/ajLote"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enviar lo pendiente y traer reservas cada (minutos)"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/ajIntervalo"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solo se usa internet cuando hay algo que enviar. Si un envío falla, el registro se conserva con el mismo id y se reintenta en el siguiente ciclo o al volver la conexión."
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajAutoReservas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Traer reservas nuevas (y el estado de validadas / ingresadas) automáticamente" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ajPrueba"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Imprimir ticket de prueba"
            android:textColor="@color/blanco"
            app:strokeColor="@color/tarjeta_borde" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ajCambiarPin"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cambiar el PIN de configuración"
            android:textColor="@color/blanco"
            app:strokeColor="@color/tarjeta_borde" />

        <TextView
            style="@style/TituloSeccion"
            android:layout_marginTop="18dp"
            android:text="FIN DEL EVENTO · BORRAR DATOS" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cuando el evento termina se puede dejar todo limpio: listado de reservas, validaciones, ingresos, fotos, alertas y lo que se sabe de los otros equipos. No se borran los ajustes (PIN, servidor, nombre ni papel) y lo que aún no se haya enviado al servidor se sigue enviando. Borra aunque haya registros sin enviar."
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ajBorradoEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/blanco"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ajBorradoNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ajBorradoProgramar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Programar borrado automático (todos los equipos)"
            android:textColor="@color/blanco"
            app:strokeColor="@color/tarjeta_borde" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ajBorradoCancelar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cancelar el borrado programado"
            android:textColor="@color/blanco"
            app:strokeColor="@color/tarjeta_borde" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ajBorradoAhora"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Borrar todo AHORA (todos los equipos)"
            android:textColor="@color/rojo"
            app:strokeColor="@color/rojo" />
    </LinearLayout>
</ScrollView>
