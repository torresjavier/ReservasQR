<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del operador">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajOperador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Encabezado del ticket (parqueadero / empresa)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajNegocio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Mensaje de bienvenida"
            app:helperText="Use {nombre} y {evento} para poner los datos del cliente.">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Mensaje extra para clientes VIP">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ajVip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Imprimir el ticket automáticamente al registrar" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incluir el QR de la reserva en el ticket" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajLector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leer el QR con el lector integrado del Sunmi (si no, con la cámara)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ajConfirmarPlaca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar antes de registrar una placa leída con la cámara" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ajPrueba"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="Imprimir ticket de prueba"
            android:textColor="@color/blanco" />
    </LinearLayout>
</ScrollView>
