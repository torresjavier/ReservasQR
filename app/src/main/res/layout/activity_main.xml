<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- ===== Encabezado ===== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circulo_blanco"
                android:gravity="center"
                android:text="O"
                android:textColor="@color/negro"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/zonaOperador"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtOperador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/texto"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSubtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/texto_suave"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPill"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pill_borde"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnAjustes"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ajustes"
                android:src="@drawable/ic_ajustes"
                app:tint="@color/texto_suave" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zonaImpresora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Impresora"
                android:src="@drawable/ic_impresora"
                app:tint="@color/texto_suave" />

            <TextView
                android:id="@+id/txtImpresora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/texto_suave"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Pestañas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabIngresos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabBuscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Buscar placa"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tarjeta_borde" />

    <!-- ===== Pestaña INGRESOS ===== -->
    <LinearLayout
        android:id="@+id/panelIngresos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Tarjeta de escaneo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/tarjeta"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="QR"
                    android:src="@drawable/ic_qr"
                    app:tint="@color/texto_suave" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.08"
                    android:text="RESERVA CON QR"
                    android:textColor="@color/texto_suave"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscanear"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Escanear el QR"
                android:textColor="@color/negro"
                android:textSize="19sp"
                android:textStyle="bold"
                app:backgroundTint="@color/blanco"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_camara"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="26dp"
                app:iconTint="@color/negro" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Apunta la cámara al QR de la reserva del cliente. Si no lo trae, usa Buscar placa."
                android:textColor="@color/texto_suave"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tarjeta del listado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/tarjeta"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/txtListado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/texto"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCargar"
                        style="@style/BotonChip"
                        android:text="Cargar Excel"
                        app:icon="@drawable/ic_archivo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBluetooth"
                        style="@style/BotonChip"
                        android:text="Bluetooth"
                        app:icon="@drawable/ic_bluetooth" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnColumnas"
                        style="@style/BotonChip"
                        android:text="Columnas"
                        app:icon="@drawable/ic_columnas" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportar"
                        style="@style/BotonChip"
                        android:text="Exportar"
                        app:icon="@drawable/ic_compartir" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReiniciar"
                        style="@style/BotonChip"
                        android:text="Reiniciar"
                        android:textColor="@color/rojo" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Encabezado de la lista -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Vehículos"
                android:src="@drawable/ic_carro"
                app:tint="@color/texto_suave" />

            <TextView
                android:id="@+id/txtAdentro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/texto_suave"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/chipVer"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/pill_borde"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/texto"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaIngresos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/vacioIngresos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:textColor="@color/texto_suave"
                android:textSize="15sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===== Pestaña BUSCAR PLACA ===== -->
    <LinearLayout
        android:id="@+id/panelBuscar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/edtPlaca"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/placa"
            android:fontFamily="monospace"
            android:gravity="center"
            android:hint="ABC123"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
            android:maxLength="20"
            android:singleLine="true"
            android:textColor="@color/negro"
            android:textColorHint="#80000000"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAyudaBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Escriba la placa (también sirve el código de la reserva o el nombre)."
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaBuscar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/vacioBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:textColor="@color/texto_suave"
                android:textSize="15sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
