<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raizPlaca"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro">

    <androidx.camera.view.PreviewView
        android:id="@+id/vistaCamara"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Zona de lectura: ponga la placa dentro de este recuadro -->
    <View
        android:id="@+id/zonaLectura"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:background="@drawable/marco_zona" />

    <!-- Marco rojo: la placa que se está leyendo -->
    <View
        android:id="@+id/marco"
        android:layout_width="310dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:background="@drawable/marco_placa"
        android:visibility="gone" />

    <!-- Encabezado -->
    <LinearLayout
        android:id="@+id/panelArriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B3000000"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="LECTURA DE PLACAS"
                    android:textColor="@color/blanco"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtModoCamara"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo continuo"
                    android:textColor="@color/texto_suave"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_rojo"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="0"
                android:textColor="@color/blanco"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Opciones de lectura: cada botón cambia al tocarlo y queda guardado -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/opMotor"
                    style="@style/ChipOpcion" />

                <TextView
                    android:id="@+id/opMetodo"
                    style="@style/ChipOpcion" />

                <TextView
                    android:id="@+id/opZoom"
                    style="@style/ChipOpcion" />

                <TextView
                    android:id="@+id/opFoco"
                    style="@style/ChipOpcion" />

                <TextView
                    android:id="@+id/opMovimiento"
                    style="@style/ChipOpcion" />

                <TextView
                    android:id="@+id/opResolucion"
                    style="@style/ChipOpcion" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Aviso grande del resultado (aparece unos segundos) -->
    <LinearLayout
        android:id="@+id/panelAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/aviso_ok"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/avisoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/avisoPlaca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/placa"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:textColor="@color/negro"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/avisoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Abajo: lectura actual y botones -->
    <LinearLayout
        android:id="@+id/panelAbajo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D9000000"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgCrop"
            android:layout_width="96dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:background="#33FFFFFF"
            android:contentDescription="Lo que está leyendo la cámara"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/txtLeida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/placa"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minWidth="190dp"
            android:paddingStart="18dp"
            android:paddingTop="6dp"
            android:paddingEnd="18dp"
            android:paddingBottom="6dp"
            android:text="------"
            android:textColor="@color/negro"
            android:textSize="32sp"
            android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtEstadoOcr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Apunte a la placa dentro del recuadro"
            android:textColor="@color/blanco"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLinterna"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Luz"
                android:textColor="@color/blanco"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_linterna"
                app:iconTint="@color/blanco"
                app:strokeColor="@color/tarjeta_borde" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscribirPlaca"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.3"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Escribir"
                android:textColor="@color/blanco"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_buscar"
                app:iconTint="@color/blanco"
                app:strokeColor="@color/tarjeta_borde" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTerminar"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.3"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Terminar"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                app:backgroundTint="@color/rojo"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
