<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Reservas" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/blanco</item>
        <item name="colorOnPrimary">@color/negro</item>
        <item name="colorSecondary">@color/rojo</item>
        <item name="colorOnSecondary">@color/blanco</item>
        <item name="colorError">@color/rojo</item>
        <item name="colorSurface">@color/tarjeta</item>
        <item name="colorOnSurface">@color/blanco</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
    </style>

    <!-- Foto de perfil redonda -->
    <style name="Circulo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Indicadores de estado del encabezado -->
    <style name="ChipEstado">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/pill_borde</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Títulos de sección en Ajustes -->
    <style name="TituloSeccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/rojo</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
